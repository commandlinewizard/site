---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Term from "../components/Term.astro";
import Wizard from "../components/Wizard.astro";
import { releasedSpells } from "../lib/spells";

// Only released episodes get a page (drafts too with CW_DRAFTS=1, never in a deploy).
export async function getStaticPaths() {
  const spells = await releasedSpells();
  return spells.map((s) => ({ params: { tool: s.data.tool }, props: { spell: s } }));
}

const { spell } = Astro.props;
const d = spell.data;
const { Content } = await render(spell);
const optionCount = d.options.length;
const keys = d.optionsKind === "keys";
---
<Base title={`${d.tool} cheat sheet: ${d.tagline} | Command Line Wizard`} description={d.description} path={`~/spells/${d.tool}`}>
  <main>
    <section class="hero" aria-labelledby="tool-name">
      <h1 id="tool-name">{d.tool}</h1>
      <p class="tagline">{d.tagline}</p>
      <Term cmd={d.hero.cmd} out={d.hero.out} />
      <p class="meta">Episode {d.episode} of season 1. Every command on this page was run with {d.version}.</p>
    </section>

    <section class="video" aria-label="Video">
      {d.youtubeId && d.published ? (
        <button class="facade" type="button" data-yt={d.youtubeId} aria-label={`Play the video: ${d.tool} in 2 minutes`}>
          <span class="play" aria-hidden="true">▶</span>
          <span>Watch <strong>{d.tool} in 2 minutes</strong></span>
          <span class="small">Loads YouTube (no-cookie) when you click.</span>
        </button>
      ) : (
        <p class="facade off">The video <strong>{d.tool} in 2 minutes</strong> is coming soon.</p>
      )}
    </section>

    <div class="intro"><Content /></div>

    <h2>install</h2>
    <dl class="install">
      {d.install.map((i) => (<><dt>{i.via}</dt><dd><Term cmd={i.cmd} /></dd></>))}
    </dl>

    <h2>the {optionCount} {keys ? "keys" : "options"} that matter</h2>
    <dl class="options">
      {d.options.map((o) => (
        <>
          <dt><code>{o.flag}</code></dt>
          <dd><p>{o.what}</p>{keys ? <p class="how">{o.example}</p> : <Term cmd={o.example} />}</dd>
        </>
      ))}
    </dl>

    <h2>recipes</h2>
    {d.recipes.map((r) => (
      <div class="recipe">
        <p>{r.task}</p>
        <Term cmd={r.cmd} out={r.out} />
      </div>
    ))}

    <h2>the trap</h2>
    <div class="trap">
      {d.wizardSays?.trap && <Wizard pose="warn" expression="deadpan" say={d.wizardSays.trap} />}
      <p class="trap-title">{d.gotcha.title}</p>
      <p class="label wrong">This breaks:</p>
      <Term cmd={d.gotcha.wrong.cmd} out={d.gotcha.wrong.out} error />
      <p class="label right">This works:</p>
      <Term cmd={d.gotcha.right.cmd} out={d.gotcha.right.out} />
      <p set:html={d.gotcha.why.replace(/`([^`]+)`/g, "<code>$1</code>")} />
    </div>

    <h2>{keys ? "every key" : "every option"}</h2>
    <div class="table-wrap">
      <table>
        <caption>From <code>{d.allOptionsSource}</code></caption>
        <thead><tr><th scope="col">{keys ? "key" : "option"}</th><th scope="col">what it does</th></tr></thead>
        <tbody>
          {d.allOptions.map((o) => (<tr><td><code>{o.flag}</code></td><td>{o.desc}</td></tr>))}
        </tbody>
      </table>
    </div>

    <h2>pairs with</h2>
    <ul class="pairs">
      {d.pairsWith.map((p) => (<li><code>{p.tool}</code>: {p.why}</li>))}
    </ul>

    <details class="eggs">
      <summary>Spoilers: the hidden jokes in this episode</summary>
      <ul>{d.eggs.map((e) => <li>{e}</li>)}</ul>
    </details>

    <p class="back"><a href="/">cd ~</a> for the other spells</p>
  </main>
</Base>

<script>
  // Click-to-load video: nothing is fetched from YouTube until the visitor asks.
  for (const btn of document.querySelectorAll<HTMLButtonElement>("button.facade")) {
    btn.addEventListener("click", () => {
      const f = document.createElement("iframe");
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1`;
      f.title = btn.getAttribute("aria-label") ?? "Video";
      f.allow = "autoplay; encrypted-media; picture-in-picture";
      f.allowFullscreen = true;
      f.className = "player";
      btn.replaceWith(f);
    });
  }
</script>

<style>
  .hero { padding: 3rem 0 1rem; }
  h1 {
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--purple);
    margin: 0;
  }
  .tagline { font-size: var(--step-1); color: var(--dim); margin: 0.5rem 0 1.5rem; }
  .hero :global(.term) { border-color: var(--purple); box-shadow: 0 0 0 4px rgb(163 113 247 / 0.12); }
  .hero :global(.term pre) { font-size: var(--step-0); padding: 1.1rem 0.5rem 1.1rem 1.2rem; }
  .hero :global(.term .out) { color: var(--green); }
  .meta { color: var(--dim); font-size: var(--step--1); }

  .facade {
    display: grid; gap: 0.25rem; justify-items: start;
    width: 100%; margin: 1rem 0 2rem; padding: 1.25rem;
    font: inherit; color: var(--text); text-align: left;
    background: var(--raised); border: 1px dashed var(--line); border-radius: 6px;
  }
  button.facade { cursor: pointer; border-style: solid; }
  button.facade:hover { border-color: var(--purple); }
  .facade .play { color: var(--red); font-size: var(--step-2); line-height: 1; }
  .facade .small, .facade.off { color: var(--dim); font-size: var(--step--1); }
  .facade.off { display: block; }
  .facade.off strong { color: var(--text); }
  :global(.player) { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 6px; margin: 1rem 0 2rem; }

  .intro :global(p) { max-width: 70ch; }

  dl { margin: 0; display: grid; grid-template-columns: 9rem 1fr; gap: 0.25rem 1.5rem; }
  dt { padding-top: 0.9rem; color: var(--dim); font-size: var(--step--1); }
  dd { margin: 0; min-width: 0; }
  .options dt code { color: var(--green); font-size: var(--step-1); font-weight: 700; }
  .options dt { padding-top: 0.1rem; }
  .options dd p { margin-bottom: 0.5rem; }
  .options dd { margin-bottom: 1.25rem; }
  .options .how { color: var(--dim); font-size: var(--step--1); }
  .options .how::before { content: "→ "; color: var(--purple); }

  .recipe p { margin: 1.5rem 0 0.5rem; }
  .recipe p::before { content: "# "; color: var(--dim); }

  .trap { border-left: 3px solid var(--red); padding-left: 1.25rem; }
  .trap-title { font-weight: 700; font-size: var(--step-1); }
  .label { margin: 1rem 0 0.4rem; font-size: var(--step--1); }
  .label.wrong { color: var(--red); }
  .label.right { color: var(--green); }

  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  caption { text-align: left; color: var(--dim); padding-bottom: 0.5rem; }
  th { text-align: left; color: var(--dim); font-weight: 400; border-bottom: 1px solid var(--line); padding: 0.4rem 1rem 0.4rem 0; }
  td { border-bottom: 1px solid var(--line); padding: 0.45rem 1rem 0.45rem 0; vertical-align: top; }
  td:first-child { white-space: nowrap; }

  .pairs { padding-left: 1.2rem; }
  .pairs li { margin-bottom: 0.4rem; }

  .eggs { margin-top: 3.5rem; border: 1px solid var(--line); border-radius: 6px; padding: 0.9rem 1.1rem; }
  .eggs summary { cursor: pointer; color: var(--yellow); }
  .eggs ul { margin: 1rem 0 0; padding-left: 1.2rem; }
  .eggs li { margin-bottom: 0.4rem; }

  .back { margin-top: 3rem; color: var(--dim); }

  @media (max-width: 640px) {
    .hero :global(.term pre) { padding: 2.3rem 1rem 1rem 1rem; }
    /* the option table becomes a list: option on one line, what it does below */
    table, caption, tbody, tr, td { display: block; }
    thead { display: none; }
    tr { border-bottom: 1px solid var(--line); padding: 0.45rem 0; }
    td { border: 0; padding: 0; }
    td:first-child { white-space: normal; overflow-wrap: anywhere; }
    dl { grid-template-columns: 1fr; }
    dt { padding-top: 0.5rem; }
    .options dd { margin-bottom: 1rem; }
  }
</style>
